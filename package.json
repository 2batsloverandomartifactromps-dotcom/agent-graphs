{
  "name": "agent-graphs-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Construct, run, monitor and audit execution graphs for agent-orchestrated software builds.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agent-graphs/server --filter @agent-graphs/web dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm check:licenses && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
